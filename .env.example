# ---------------------------------------------------------------
# Copy to .env.local for local development. On Vercel, add the same
# keys under Project → Settings → Environment Variables.
# Never commit real values.
# ---------------------------------------------------------------

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used by crons, imports and user management. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the deployed app (used in invite / reset-password links and report emails)
NEXT_PUBLIC_SITE_URL=https://lost-pod.vercel.app

# Shared secret for Vercel Cron → /api/cron/* (Vercel sends it as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=generate-a-long-random-string

# ---------- Google: Apps Script bridge (no Google Cloud needed; see SETUP.md part B) ----------
GOOGLE_BRIDGE_URL=
GOOGLE_BRIDGE_SECRET=

# ---------- Google: option A — service account (recommended) ----------
# Share every tracker workbook with GOOGLE_SERVICE_ACCOUNT_EMAIL (Viewer is enough).
# For Gmail, enable domain-wide delegation for the service account with the scopes
#   https://www.googleapis.com/auth/gmail.readonly
#   https://www.googleapis.com/auth/gmail.send
# and set GMAIL_IMPERSONATE_USER to the mailbox that receives client escalations.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with literal \n line breaks, e.g. "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GMAIL_IMPERSONATE_USER=pod-escalations@shadowfax.in

# ---------- Google: option B — OAuth refresh token for one mailbox ----------
# Used when no service account is configured. Scopes: gmail.readonly, gmail.send, spreadsheets.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Address the daily report is sent from (must be the impersonated / OAuth mailbox or one of its aliases)
GMAIL_SENDER=pod-escalations@shadowfax.in
