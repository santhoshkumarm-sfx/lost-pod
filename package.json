{
  "name": "lost-pod-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Lost Shipment / POD escalation management for the Trust & Safety team",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "create-admin": "tsx --conditions=react-server scripts/create-super-admin.ts",
    "sync:sheets": "tsx --conditions=react-server scripts/sync-sheets.ts",
    "report:send": "tsx --conditions=react-server scripts/send-daily-report.ts",
    "test:db": "bash supabase/tests/run.sh",
    "setup": "tsx --conditions=react-server scripts/setup.ts"
  },
  "dependencies": {
    "@googleapis/gmail": "^22.0.1",
    "@googleapis/sheets": "^18.0.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "exceljs": "^3.4.0",
    "google-auth-library": "^11.0.0",
    "next": "15.5.27",
    "node-html-parser": "^7.0.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.4.21",
    "dotenv": "^16.4.7",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
