{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "bom1"
  ],
  "crons": [
    {
      "path": "/api/cron/sync-sheets",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/daily-report",
      "schedule": "30 3 * * *"
    }
  ],
  "functions": {
    "src/app/api/cron/**/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/export/**/route.ts": {
      "maxDuration": 60
    }
  }
}
