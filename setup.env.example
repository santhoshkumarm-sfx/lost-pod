# ======================================================================
# One-command setup. Copy this file to "setup.env", fill it in, then run:
#     npm install
#     npm run setup
# setup.env holds secrets: it is git-ignored and never uploaded to Vercel.
# Safe to run again any time (e.g. after fixing a value) — nothing is duplicated.
# ======================================================================

# ---------- Supabase (required) ----------
# Project ref = the part before .supabase.co in your project URL,
# e.g. https://abcdefghijklmnop.supabase.co  ->  abcdefghijklmnop
SUPABASE_PROJECT_REF=
# Personal access token: supabase.com/dashboard/account/tokens -> "Generate new token"
SUPABASE_ACCESS_TOKEN=

# ---------- First Super Admin (required) ----------
ADMIN_EMAIL=binay.sharma@shadowfax.in
ADMIN_NAME=Binay Sharma
# Leave empty to get an invitation email instead (min 10 characters if set)
ADMIN_PASSWORD=

# ---------- Google (recommended; can be added later and the script re-run) ----------
# Path to the JSON key file downloaded for the service account, e.g. ./google-key.json
GOOGLE_SERVICE_ACCOUNT_JSON=./google-key.json
# Mailbox that receives client escalations (needs domain-wide delegation, see SETUP.md)
GMAIL_IMPERSONATE_USER=
# Address the daily report is sent from (defaults to the mailbox above)
GMAIL_SENDER=

# ---------- Vercel (optional: leave empty to skip deployment) ----------
# vercel.com/account/tokens -> "Create Token"
VERCEL_TOKEN=
VERCEL_PROJECT_NAME=lost-pod-dashboard
# Only if the project should live under a Vercel team: the team ID or slug
VERCEL_TEAM=
# Only if you use your own domain, e.g. https://pod.shadowfax.in
SITE_URL=

# ---------- Email sending for invites / password resets (optional, recommended) ----------
# Supabase's built-in mailer sends only a few emails per hour. With a real SMTP server
# (e.g. Google Workspace SMTP relay or an app password) invitations go out reliably.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=Lost & POD desk
